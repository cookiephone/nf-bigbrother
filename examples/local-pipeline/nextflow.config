// Enable the BigBrother observer and configure where its output is written.
plugins {
  id 'nf-bigbrother@1.0.1'
}

bigbrother {
  outputDir  = 'bb_out'   // the event log and final snapshot are written here
  emitEvents = true       // one JSON line per task, appended as the run goes
  emitDot    = true       // also emit a Graphviz .dot alongside each JSON
}

// (optional) Nextflow's own abstract, process-level DAG for comparison
dag {
  enabled   = true
  file      = 'abstract-dag.dot'
  overwrite = true
}
