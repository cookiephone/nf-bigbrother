// Enable the BigBrother observer and configure where snapshots are written.
plugins {
  id 'nf-bigbrother@1.0.0'
}

bigbrother {
  outputDir    = 'bb_out'   // physical-graph snapshots are written here
  emitPartials = true        // write a snapshot after every task completes
  emitDot      = true        // also emit a Graphviz .dot alongside each JSON
}

// (optional) Nextflow's own abstract, process-level DAG for comparison
dag {
  enabled   = true
  file      = 'abstract-dag.dot'
  overwrite = true
}
