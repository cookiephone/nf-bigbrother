// Minimal configuration to enable the nf-bigbrother observer.
plugins {
  id 'nf-bigbrother@0.7.0'
}

// All settings are optional; the defaults are shown below.
bigbrother {
  outputDir    = 'bigbrother'   // directory for JSON/DOT snapshots
  emitPartials = true           // write a snapshot after every completed task
  emitDot      = true           // also emit a Graphviz .dot per snapshot
  prefix       = ''             // optional snapshot filename prefix
}

// (optional) Nextflow's own abstract (process-level) DAG, for comparison with
// the physical (task-level) graph produced by BigBrother.
dag {
  enabled   = true
  file      = 'abstract-dag.dot'
  overwrite = true
}
