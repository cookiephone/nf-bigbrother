{
    "extends": "recommended",
    "rules": {
        "ClassJavadoc": {
            "enabled": false
        },
        "CompileStatic": {
            "enabled": false
        },
        "DuplicateNumberLiteral": {
            "enabled": false
        },
        "DuplicateStringLiteral": {
            "enabled": false
        },
        "IfStatementBraces": {
            "enabled": false
        },
        "ImplicitClosureParameter": {
            "enabled": false
        },
        "Instanceof": {
            "enabled": false
        },
        "InvertedIfElse": {
            "enabled": false
        },
        "LineLength": {
            "enabled": false
        },
        "NoDef": {
            "enabled": false
        },
        "NoFloat": {
            "enabled": false
        },
        "UnnecessaryGetter": {
            "enabled": false
        },
        "VariableTypeRequired": {
            "enabled": false
        }
    }
}